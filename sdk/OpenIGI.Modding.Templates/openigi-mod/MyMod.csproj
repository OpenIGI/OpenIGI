<Project Sdk="OpenIGI.Modding.Sdk/SDK_VERSION">

  <!--
    The mod. Its manifest (mod.json) is written from these properties, and every build makes bin/<config>/net10.0/mod/, the
    folder the launcher installs. The SDK's version is the oldest game build the mod works with.

    Files in a data/ folder beside this project mirror the game's own folders and win over them while the mod is on:
    data/common/textures/x.tex stands for the game's common/textures/x.tex, and a .res there for each of its entries.
  -->
  <PropertyGroup>
    <!-- Unique among every published mod: lowercase letters, digits and dashes. -->
    <ModId>MOD_ID</ModId>
    <ModName>MyMod</ModName>
    <Version>0.1.0</Version>
    <ModSummary>What the mod does, in a line.</ModSummary>
    <Authors>AUTHOR</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <!-- The games it is for: igi1, igi2, or both (igi1;igi2); empty for every game. -->
    <ModTitles>igi1</ModTitles>
    <!-- Other games whose installed data it reads, if any: it is left out where one is not installed. -->
    <ModRequiresTitleData></ModRequiresTitleData>
    <!-- Whether it changes what happens in play, not only how it looks or sounds. -->
    <ModAffectsSimulation>true</ModAffectsSimulation>
  </PropertyGroup>

  <ItemGroup>
    <!-- Mods it needs played with it, each with the oldest version that will do. -->
    <!-- <ModDependency Include="other-mod" Version=">=1.0" /> -->

    <!-- Campaigns it adds beside the game's own: a name, and the ids its missions define, in the order they are played.
         The missions themselves are folders under data/missions/, each with its mission.qvm, as the game's are. -->
    <!-- <ModCampaign Include="Operation Nightfall" Missions="901;902;903" /> -->
  </ItemGroup>

</Project>
