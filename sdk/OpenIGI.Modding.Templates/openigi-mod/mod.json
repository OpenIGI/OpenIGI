{
  // Unique among every published mod: lowercase letters, digits and dashes.
  "id": "MOD_ID",
  "name": "MyMod",
  "version": "0.1.0",
  "apiVersion": 1,
  "summary": "What the mod does, in a line.",
  "authors": [ "AUTHOR" ],
  "license": "MIT",
  // The games it is for: "igi1", "igi2", or both; empty for every game.
  "titles": [ "igi1" ],
  // Other games whose installed data it reads, if any; it is left out where one is not installed.
  "requiresTitleData": [],
  // Mods it needs played with it, each with the oldest version that will do: { "other-mod": ">=1.0" }.
  "dependencies": {},
  "assembly": "MyMod.dll",
  // Whether it changes what happens in play, not only how it looks or sounds.
  "affectsSimulation": true
}
