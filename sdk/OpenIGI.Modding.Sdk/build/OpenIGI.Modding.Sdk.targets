<Project>

  <!--
    A mod's package: the folder an installed mod is, which the launcher installs and the game's loader reads.

    Built beside the mod's output (bin/<config>/<tfm>/mod/) after every build of a project with a mod.json, it holds
    the mod.json, the mod's assembly, its symbols and dependency manifest, the files the project itself copies to its
    output (a mod's own data), and the assemblies of the packages the mod itself references. Nothing of the game's: the
    port's assemblies and the packages they bring are the game's own at run time, which the loader gives every mod, so a
    mod built against the game never carries a second copy of them.
  -->
  <!-- NuGet imports the props itself, early; a project in this repository imports this file alone. -->
  <Import Project="OpenIGI.Modding.Sdk.props" Condition="'$(_OpenIgiModdingSdkProps)' != 'true'" />

  <Target Name="PackMod"
          AfterTargets="Build"
          DependsOnTargets="GetCopyToOutputDirectoryItems"
          Condition="Exists('$(MSBuildProjectDirectory)\mod.json')">
    <PropertyGroup>
      <!-- Here rather than above: a project imports this before the SDK names its output folder. -->
      <ModPackageDirectory Condition="'$(ModPackageDirectory)' == ''">$(OutDir)mod\</ModPackageDirectory>
      <_ModOwnPackages>;@(PackageReference->'%(Identity)'->ToLowerInvariant());</_ModOwnPackages>
      <_ModProjectDirectory>$([MSBuild]::EnsureTrailingSlash('$(MSBuildProjectDirectory)'))</_ModProjectDirectory>
    </PropertyGroup>

    <ItemGroup>
      <_ModFile Include="@(IntermediateAssembly->'%(FullPath)')" TargetPath="$(TargetFileName)" />
      <_ModFile Include="$(ProjectDepsFilePath)" TargetPath="$(ProjectDepsFileName)" Condition="Exists('$(ProjectDepsFilePath)')" />
      <_ModFile Include="$(TargetDir)$(TargetName).pdb" TargetPath="$(TargetName).pdb" Condition="Exists('$(TargetDir)$(TargetName).pdb')" />

      <!-- The project's own files copied to its output: mod.json and whatever data it ships. -->
      <_ModFile Include="@(AllItemsFullPathWithTargetPath)"
                Condition="$([System.String]::Copy('%(FullPath)').StartsWith('$(_ModProjectDirectory)', System.StringComparison.OrdinalIgnoreCase))" />

      <!-- The packages the mod references itself, with their native and satellite files; never one of the port's. -->
      <_ModFile Include="@(ReferenceCopyLocalPaths)"
                TargetPath="%(ReferenceCopyLocalPaths.DestinationSubDirectory)%(Filename)%(Extension)"
                Condition="'%(ReferenceCopyLocalPaths.NuGetPackageId)' != ''
                           and !$([System.String]::Copy('%(ReferenceCopyLocalPaths.NuGetPackageId)').StartsWith('OpenIGI.'))
                           and $(_ModOwnPackages.Contains(';$([System.String]::Copy('%(ReferenceCopyLocalPaths.NuGetPackageId)').ToLowerInvariant());'))" />
    </ItemGroup>

    <RemoveDir Directories="$(ModPackageDirectory)" />
    <Copy SourceFiles="@(_ModFile)" DestinationFiles="@(_ModFile->'$(ModPackageDirectory)%(TargetPath)')" />
    <Message Importance="normal" Text="$(MSBuildProjectName) -> $(ModPackageDirectory) (mod package)" />
  </Target>

</Project>
