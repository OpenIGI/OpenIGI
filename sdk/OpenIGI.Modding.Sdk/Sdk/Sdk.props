<Project>

  <!--
    OpenIGI.Modding.Sdk, the project SDK a mod is built with:

      <Project Sdk="OpenIGI.Modding.Sdk/0.5.0">
        <PropertyGroup>
          <ModId>mymod</ModId>
          <ModName>My mod</ModName>
          <Version>1.0.0</Version>
          <ModTitles>igi1</ModTitles>
        </PropertyGroup>
      </Project>

    It is the .NET SDK with what a mod needs on top: the game's assemblies to build against, the source generator that writes
    a mod's Configure from its attributes, the mod.json written from the project's properties, and the folder the launcher
    installs (bin/<config>/<tfm>/mod/). See OpenIGI.Modding.targets.
  -->

  <!-- The version the SDK was packed as, which the game's packages are referenced at; absent in a checkout. -->
  <Import Project="Version.props" Condition="Exists('$(MSBuildThisFileDirectory)Version.props')" />

  <!--
    Where the game is built from: a checkout of its source when one is to hand, else the packages at the SDK's version.

    The checkout is the one OpenIgiRoot or OPENIGI_ROOT names, the one this SDK file lives in, or an igi-remastered folder up
    to three levels above the project. Built from a checkout, the game's projects are referenced (OpenIGI.Modding.targets).
  -->
  <PropertyGroup>
    <OpenIgiRoot Condition="'$(OpenIgiRoot)' == '' and '$(OPENIGI_ROOT)' != ''">$(OPENIGI_ROOT)</OpenIgiRoot>
    <OpenIgiRoot Condition="'$(OpenIgiRoot)' == '' and Exists('$(MSBuildThisFileDirectory)..\..\..\OpenIGI.slnx')">$(MSBuildThisFileDirectory)..\..\..\</OpenIgiRoot>
    <OpenIgiRoot Condition="'$(OpenIgiRoot)' == '' and Exists('$(MSBuildProjectDirectory)\..\igi-remastered\OpenIGI.slnx')">$(MSBuildProjectDirectory)\..\igi-remastered\</OpenIgiRoot>
    <OpenIgiRoot Condition="'$(OpenIgiRoot)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\igi-remastered\OpenIGI.slnx')">$(MSBuildProjectDirectory)\..\..\igi-remastered\</OpenIgiRoot>
    <OpenIgiRoot Condition="'$(OpenIgiRoot)' == '' and Exists('$(MSBuildProjectDirectory)\..\..\..\igi-remastered\OpenIGI.slnx')">$(MSBuildProjectDirectory)\..\..\..\igi-remastered\</OpenIgiRoot>
    <OpenIgiRoot Condition="'$(OpenIgiRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(OpenIgiRoot)'))</OpenIgiRoot>
    <OpenIgiFromSource Condition="'$(OpenIgiRoot)' != ''">true</OpenIgiFromSource>
  </PropertyGroup>

  <!--
    The SDK itself: from the checkout when the game is built from one, so that a change to it needs no new package, or else
    the one this package carries.
  -->
  <PropertyGroup>
    <_OpenIgiSdkDirectory Condition="'$(OpenIgiFromSource)' == 'true' and Exists('$(OpenIgiRoot)sdk\OpenIGI.Modding.Sdk\Sdk\OpenIGI.Modding.props')">$(OpenIgiRoot)sdk\OpenIGI.Modding.Sdk\Sdk\</_OpenIgiSdkDirectory>
    <_OpenIgiSdkDirectory Condition="'$(_OpenIgiSdkDirectory)' == ''">$(MSBuildThisFileDirectory)</_OpenIgiSdkDirectory>
  </PropertyGroup>

  <Import Project="$(_OpenIgiSdkDirectory)OpenIGI.Modding.props" />

</Project>
