<Project>

  <!-- Applies to every project in the repository. Keep project files free of boilerplate. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>preview</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NuGetAudit>false</NuGetAudit>

    <!-- Enterprise-grade hygiene: no warnings, XML docs on all public members (CS1591). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- A release build is given its version by the release workflow (-p:Version=0.2.0-beta.3), taken from
         the tag it was cut as; anything built without one says so. The SDK appends +<commit> to the
         informational version, which is what the game and the launcher display. -->
    <Version Condition="'$(Version)' == ''">0.0.0-dev</Version>

    <Product>OpenIGI</Product>
    <Authors>OpenIGI Contributors</Authors>
    <Copyright>Copyright (c) OpenIGI Contributors</Copyright>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
    <RepositoryType>git</RepositoryType>

    <!-- Determinism-friendly builds -->
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <AccelerateBuildsInVisualStudio>true</AccelerateBuildsInVisualStudio>
  </PropertyGroup>

  <!--
    The shared libraries are trimmed and compiled ahead of time in the browser build, so the trim and AOT
    analysers run on every one of them and, with warnings as errors, keep them that way. Not on the source
    generator (netstandard2.0, never shipped), the desktop-only Vulkan and Direct3D 12 backends a browser never
    loads, or the mod loader, which loads assemblies at run time and so is for JIT builds alone.
  -->
  <PropertyGroup Condition="$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').StartsWith('src'))
                            and '$(MSBuildProjectName)' != 'OpenIGI.Generators'
                            and '$(MSBuildProjectName)' != 'OpenIGI.Rendering.Vulkan'
                            and '$(MSBuildProjectName)' != 'OpenIGI.Rendering.D3D12'
                            and '$(MSBuildProjectName)' != 'OpenIGI.Modding.Loader'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <!-- The APIs no project may call: output goes through the logger (see BannedSymbols.txt). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)BannedSymbols.txt" Link="BannedSymbols.txt" Visible="false" />
  </ItemGroup>

</Project>
