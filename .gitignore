# Build results
[Bb]in/
[Oo]bj/
[Oo]ut/
artifacts/
TestResults/

# IDE
.vs/
.vscode/
.idea/
*.user
*.suo
*.DotSettings.user
*.userprefs

# NuGet
*.nupkg
packages/

# JS tooling (any frontend tooling committed to this repo)
node_modules/
.next/
dist/

# Environment and secrets
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

# AI agent tooling, config and caches
.claude/
.claude.json
.codex/
.skills/
.opencode/
.agents/
.cursor/
.copilot/
.continue/
.pi/
.pi/extensions/
.mcp.json
# Local-only reverse-engineering tooling (installed, not committed)
ghidra-headless-mcp/
*.har
~/

# Coverage / logs
*.log
coverage/
*.coverage
*.trx

# Local-only settings
*.local.json

# Original game data must never be committed
gamedata/
*.qvm
*.res
*.mef
*.mtp
!tests/**/fixtures/**
*.stackdump

# a probe build output
a probe of the running original

# Scratch space for the remaster track's reference captures (tools/capture-reference.sh).
.capture-tmp/
.capture-compare/

# Derived surface maps. Regenerated from the game's own textures by `ResExtract images` followed by
# `ResExtract maps`, so they are reproducible rather than authored -- and they are the game's art with
# a filter over it, which is not this repository's to carry.
.textures/


# Working notes, design docs and reverse-engineering write-ups are kept locally rather than
# carried in the repository. The two documents that address people reading it are the exception.
*.md
!/README.md
!/CONTRIBUTING.md
!/GPU-PERFORMANCE.md
!src/OpenIGI.Generators/AnalyzerReleases.*.md
!.github/**/*.md
# An added asset's provenance, licence and preparation recipe are not working notes: they have to
# ship with the binary they describe, or nobody downstream can tell what they are allowed to do with it.
!apps/OpenIGI.Composition/Assets/**/README.md

# Debug captures written next to the executable by the terrain/birdseye dumps.
/out_*.bmp
/out_*.png

# Reference captures and generated format notes kept beside the code but not carried here.
/docs/


# Scratch space for local build/run scripts and throwaway work.
/scratch/
/scratch/macos/*.sh
/scratch/macos/*.bash

# Isolated local worktrees for feature code and macOS playtests.
/.worktrees/
NuGetPackages.config
NuGet.config

# BenchmarkDotNet writes its reports and generated harness projects here.
BenchmarkDotNet.Artifacts/

# Vendor SDKs and runtimes fetched onto a developer's machine rather than carried here. They are
# proprietary redistributables and this repository is GPL-3.0, so an accidental `git add -A` must not
# be able to pull one in.
third-party/

# Python. The repository had no Python dependency before tools/texture-forge, so this section starts here.
# uv.lock IS committed -- it is what makes a run reproducible; the environment it builds is not.
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
