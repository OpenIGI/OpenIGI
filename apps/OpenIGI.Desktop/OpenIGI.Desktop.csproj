<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationIcon>Assets\openigi.ico</ApplicationIcon>
    <!-- The Vulkan surface bridge reads the window's required-extension list and creates the surface
         through raw handles, both of which are pointer operations. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Compact the large-object heap when it fragments. A level's pictures pass through it as
         multi-megabyte arrays on every load, and the workstation collector otherwise leaves the holes they
         leave behind as memory the process keeps. -->
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <PropertyGroup>
    <!-- Whether this build produces something that will run on macOS: a macOS runtime identifier, or no
         runtime identifier at all on a macOS host. -->
    <TargetsMacOS Condition="$(RuntimeIdentifier.StartsWith('osx'))">true</TargetsMacOS>
    <TargetsMacOS Condition="'$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('OSX'))">true</TargetsMacOS>
  </PropertyGroup>

  <ItemGroup>
    <!-- The composition root's own decisions (which graphics API a run starts on, and which one the
         switch moves to) are internal to it; its test project may see them. -->
    <InternalsVisibleTo Include="OpenIGI.Desktop.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\OpenIGI.Core\OpenIGI.Core.csproj" />
    <ProjectReference Include="..\..\src\Engine\OpenIGI.Engine\OpenIGI.Engine.csproj" />
    <ProjectReference Include="..\..\src\Game\OpenIGI.Game\OpenIGI.Game.csproj" />
    <ProjectReference Include="..\..\src\Game\OpenIGI.Game.Igi1\OpenIGI.Game.Igi1.csproj" />
    <ProjectReference Include="..\..\src\Game\OpenIGI.Game.Igi2\OpenIGI.Game.Igi2.csproj" />
    <ProjectReference Include="..\..\src\Engine\OpenIGI.Modding\OpenIGI.Modding.csproj" />
    <ProjectReference Include="..\..\src\Core\OpenIGI.Formats\OpenIGI.Formats.csproj" />
    <ProjectReference Include="..\..\src\Core\OpenIGI.Scripting\OpenIGI.Scripting.csproj" />
    <ProjectReference Include="..\..\src\Rendering\OpenIGI.Rendering\OpenIGI.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Game\OpenIGI.Presentation\OpenIGI.Presentation.csproj" />
    <ProjectReference Include="..\..\src\Engine\OpenIGI.Host\OpenIGI.Host.csproj" />
    <ProjectReference Include="..\..\src\Rendering\OpenIGI.Rendering.Vulkan\OpenIGI.Rendering.Vulkan.csproj" />
    <ProjectReference Include="..\..\src\Rendering\OpenIGI.Rendering.Pipeline\OpenIGI.Rendering.Pipeline.csproj" />
    <ProjectReference Include="..\..\src\Rendering\OpenIGI.Rendering.WebGpu\OpenIGI.Rendering.WebGpu.csproj" />
    <ProjectReference Include="..\..\src\UI\OpenIGI.UI\OpenIGI.UI.csproj" />
    <ProjectReference Include="..\..\src\Game\OpenIGI.Frontend\OpenIGI.Frontend.csproj" />
    <ProjectReference Include="..\..\src\Audio\OpenIGI.Audio\OpenIGI.Audio.csproj" />
    <ProjectReference Include="..\..\src\Audio\OpenIGI.Audio.OpenAL\OpenIGI.Audio.OpenAL.csproj" />
    <ProjectReference Include="..\..\src\Platform\OpenIGI.Input\OpenIGI.Input.csproj" />
    <ProjectReference Include="..\..\src\Platform\OpenIGI.Platform\OpenIGI.Platform.csproj" />
    <ProjectReference Include="..\..\src\Platform\OpenIGI.Platform.Desktop\OpenIGI.Platform.Desktop.csproj" />
    <ProjectReference Include="..\OpenIGI.Composition\OpenIGI.Composition.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The window icon. The host's own assets come with OpenIGI.Composition. -->
    <None Include="Assets\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emits the [CVarContainer] registrations. Build-time only: nothing of it ships. -->
    <ProjectReference Include="..\..\src\Core\OpenIGI.Generators\OpenIGI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="PublishTrimmed;TrimMode;PublishReadyToRun;PublishSingleFile;IncludeNativeLibrariesForSelfExtract;SelfContained;RuntimeIdentifier" />
  </ItemGroup>

  <!-- GLFW decides whether Vulkan exists by dlopen'ing a file called exactly "libvulkan.1.dylib": one
       leaf name, hard coded, and the only one it will try. Silk asks it that question before it will
       create a Vulkan window at all, so on macOS the game fell over at window creation with "GLFW ...
       doesn't support Vulkan on this computer" on a machine whose Vulkan works perfectly.
       Silk.NET.MoltenVK.Native ships the loader under its own name, libMoltenVK.dylib, which satisfies
       Silk's own loader and not GLFW's.

       MoltenVK exports the Vulkan entry points directly (it is an ICD that can also serve as the
       loader), so a copy under the name GLFW looks for is a working loader rather than a shim. Beside
       the executable is where it belongs for a build run in place: dlopen searches the working
       directory for a bare leaf name. It is not where a bundle wants it, because Finder and the Dock
       launch with a working directory of "/" and GLFW's only fallback is the main bundle's private
       frameworks directory; tools/package-macos.sh moves this copy into Contents/Frameworks. -->
  <Target Name="CopyMoltenVkAsVulkanLoader" AfterTargets="Build" Condition="'$(TargetsMacOS)' == 'true'">
    <ItemGroup>
      <!-- Distinct because every project reference contributes the same paths, and .dylib because the
           package also carries static libMoltenVK.a for the phone and TV runtimes. -->
      <MoltenVkLoader Include="@(ReferenceCopyLocalPaths->Distinct())"
                      Condition="'%(Filename)%(Extension)' == 'libMoltenVK.dylib'" />
    </ItemGroup>
    <Copy SourceFiles="@(MoltenVkLoader)" DestinationFiles="$(OutDir)libvulkan.1.dylib"
          SkipUnchangedFiles="true" Condition="'@(MoltenVkLoader)' != ''" />
  </Target>

  <!-- Again for publish, whose output is a different folder assembled by a different item list. -->
  <Target Name="PublishMoltenVkAsVulkanLoader" AfterTargets="Publish" Condition="'$(TargetsMacOS)' == 'true'">
    <ItemGroup>
      <MoltenVkPublishedLoader Include="@(ResolvedFileToPublish->Distinct())"
                               Condition="'%(Filename)%(Extension)' == 'libMoltenVK.dylib'" />
    </ItemGroup>
    <Copy SourceFiles="@(MoltenVkPublishedLoader)" DestinationFiles="$(PublishDir)libvulkan.1.dylib"
          SkipUnchangedFiles="true" Condition="'@(MoltenVkPublishedLoader)' != ''" />
  </Target>

</Project>
