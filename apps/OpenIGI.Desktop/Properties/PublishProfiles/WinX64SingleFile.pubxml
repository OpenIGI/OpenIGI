<?xml version="1.0" encoding="utf-8"?>
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <TargetFramework>net9.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>

    <!-- One executable, with native dependencies and authored assets bundled for self-extraction. -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>

    <!-- Startup and steady-state performance. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredCompilation>true</TieredCompilation>
    <TieredPGO>true</TieredPGO>

    <!-- Partial trimming is safer for the reflection-heavy graphics/audio stack. -->
    <PublishTrimmed>true</PublishTrimmed>
    <TrimMode>partial</TrimMode>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- Silk.NET 2.22 uses dynamic native binding and currently emits IL2104 during linking. -->
    <NoWarn>$(NoWarn);IL2104</NoWarn>

    <!-- Avoid spending CPU on a compressed bundle or carrying debug payloads. -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <PublishDocumentationFiles>false</PublishDocumentationFiles>
    <PublishDocumentationFile>false</PublishDocumentationFile>
    <PublishReferencesDocumentationFiles>false</PublishReferencesDocumentationFiles>
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>

    <PublishDir>bin\Release\net9.0\win-x64\publish\</PublishDir>
  </PropertyGroup>

  <Target Name="RemovePublishDebugSidecars" AfterTargets="Publish">
    <ItemGroup>
      <PublishDebugSidecar Include="$(PublishDir)**\*.pdb" />
      <PublishDebugSidecar Include="$(PublishDir)**\*.xml" />
    </ItemGroup>
    <Delete Files="@(PublishDebugSidecar)" />
  </Target>
</Project>
