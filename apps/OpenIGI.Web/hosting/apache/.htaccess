# OpenIGI web build on Apache (cPanel): goes beside index.html in the publish's wwwroot.
# Serves the pre-compressed .br / .gz files the publish wrote beside each file, with the right types.

Options -Indexes

# --- Types the runtime needs --------------------------------------------------------------------
AddType application/wasm            .wasm
AddType text/javascript             .js .mjs
AddType application/json            .json
AddType application/octet-stream    .dat .dll .pdb .blat .webcil

# --- Pre-compressed files ------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Brotli first, where the browser accepts it and the file exists.
  RewriteCond %{HTTP:Accept-Encoding} br
  RewriteCond %{REQUEST_FILENAME}.br -f
  RewriteRule ^(.+)$ $1.br [L]

  # Otherwise gzip.
  RewriteCond %{HTTP:Accept-Encoding} gzip
  RewriteCond %{REQUEST_FILENAME}.gz -f
  RewriteRule ^(.+)$ $1.gz [L]
</IfModule>

# The type of a compressed file is the type of the file it holds, set by its full name rather than by a
# rewrite flag, which not every host honours: a .js sent as application/octet-stream is refused by the
# browser as a module script and the page stops at "Loading...".
<FilesMatch "\.wasm\.(br|gz)$">
  ForceType application/wasm
</FilesMatch>
<FilesMatch "\.m?js\.(br|gz)$">
  ForceType text/javascript
</FilesMatch>
<FilesMatch "\.json\.(br|gz)$">
  ForceType application/json
</FilesMatch>
<FilesMatch "\.html\.(br|gz)$">
  ForceType text/html
</FilesMatch>
<FilesMatch "\.css\.(br|gz)$">
  ForceType text/css
</FilesMatch>
<FilesMatch "\.(dat|dll|pdb|blat|webcil)\.(br|gz)$">
  ForceType application/octet-stream
</FilesMatch>

# Never compress an already compressed file a second time.
<FilesMatch "\.(br|gz)$">
  SetEnv no-gzip 1
  SetEnv no-brotli 1
</FilesMatch>

<IfModule mod_headers.c>
  <FilesMatch "\.br$">
    Header set Content-Encoding br
    Header append Vary Accept-Encoding
  </FilesMatch>
  <FilesMatch "\.gz$">
    Header set Content-Encoding gzip
    Header append Vary Accept-Encoding
  </FilesMatch>

  # Everything at this level keeps its name from one build to the next -- the page, its scripts, the host's
  # assets -- so a browser revalidates it on every load (a small 304 while it is unchanged) and a new
  # upload is picked up at once. The runtime under _framework has a content hash in every name and is kept
  # for good instead: see _framework/.htaccess.
  Header set Cache-Control "no-cache"
</IfModule>
