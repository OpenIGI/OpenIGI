<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The desktop app's own logic: the cameras, and the arithmetic the mission-entry shot is made of.
         None of it touches a graphics device, which is the whole reason it can be tested at all. -->
    <ProjectReference Include="..\..\apps\OpenIGI.Desktop\OpenIGI.Desktop.csproj" />
    <ProjectReference Include="..\OpenIGI.TestSupport\OpenIGI.TestSupport.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\apps\OpenIGI.Desktop\Assets\fonts\Saira-Regular.ttf"
          Link="Assets\fonts\Saira-Regular.ttf"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The storm's drop sheet, so the tests that read its layout read the shipped images rather than a
         copy of them that is free to drift. -->
    <None Include="..\..\apps\OpenIGI.Desktop\Assets\weather\*.png"
          Link="Assets\weather\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />

    <!-- The lamps named by hand, for the same reason: the test has to read the file the game ships, or
         it pins a copy that is free to drift away from it. -->
    <None Include="..\..\apps\OpenIGI.Desktop\Assets\lamps.json"
          Link="Assets\lamps.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
