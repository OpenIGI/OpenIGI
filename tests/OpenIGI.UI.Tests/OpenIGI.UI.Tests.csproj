<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\src\OpenIGI.Core\OpenIGI.Core.csproj" />
    <ProjectReference Include="..\..\src\OpenIGI.Rendering\OpenIGI.Rendering.csproj" />
    <ProjectReference Include="..\..\src\OpenIGI.UI\OpenIGI.UI.csproj" />
    <ProjectReference Include="..\..\src\OpenIGI.UI.Rhi\OpenIGI.UI.Rhi.csproj" />
    <ProjectReference Include="..\..\src\OpenIGI.UI.Kit\OpenIGI.UI.Kit.csproj" />
    <ProjectReference Include="..\..\src\OpenIGI.UI.Skia\OpenIGI.UI.Skia.csproj" />
    <ProjectReference Include="..\OpenIGI.TestSupport\OpenIGI.TestSupport.csproj" />
  </ItemGroup>

  <!--
    The shipped Barlow faces, so the text tests measure and pack the exact files the game rasterises at
    startup rather than a stand-in. A font that packs in a test but not in the game is the failure worth
    catching.
  -->
  <ItemGroup>
    <None Include="..\..\apps\OpenIGI.Composition\Assets\fonts\*.ttf"
          Link="Assets\fonts\%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

</Project>
