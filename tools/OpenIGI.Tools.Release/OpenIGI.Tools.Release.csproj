<Project Sdk="Microsoft.NET.Sdk">

  <!-- Writes a release's manifest (release.json) from the archives the release workflow built and the
       changelog git-cliff worked out. It references only the release contract, which the update service
       and the launcher read the manifest through, and the shared tool host. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenIGI.Releases.Tests" />
  </ItemGroup>

  <!-- The site's stylesheet and the standings' drawing are the browser build's own; the site build carries them so the pages
       it writes (SiteChrome) never wait on the next browser build to be styled. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\apps\OpenIGI.Web\wwwroot\landing\site.css" LogicalName="OpenIGI.Site.site.css" />
    <EmbeddedResource Include="..\..\apps\OpenIGI.Web\wwwroot\landing\board.js" LogicalName="OpenIGI.Site.board.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\OpenIGI.Releases\OpenIGI.Releases.csproj" />
    <ProjectReference Include="..\OpenIGI.Tools.Common\OpenIGI.Tools.Common.csproj" />
  </ItemGroup>

</Project>
