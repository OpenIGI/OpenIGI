# master.openigi.com on the release VM: the master server (workerd, the compose service `master`) behind Caddy, behind
# Cloudflare's proxy. Goes in /srv/openigi/config/Caddyfile beside data.openigi.com.
#
# The master takes CF-Connecting-IP as the address a server or a room's host is at, and cf-iplatitude/longitude as where
# a player is: only Cloudflare's edge may say so, so nothing else reaches it. The ranges are
# https://www.cloudflare.com/ips-v4 and /ips-v6 (2026-11-10); a new one Cloudflare adds is turned away until it is here.
# The ACME challenge Caddy answers itself, before any of this, so the certificate still renews.

master.openigi.com {
	@edge remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32

	handle @edge {
		reverse_proxy master:8790
	}

	handle {
		respond 403
	}

	header -Server
}
