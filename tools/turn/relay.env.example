# A relay's settings, read by install.sh and tls-cert.sh. Copy to relay.env beside install.sh and fill in.
# OPERATORS.md explains each one.

# The address players reach the relay at. Required.
PUBLIC_IP=203.0.113.10

# Only on a machine that sits behind a 1:1 NAT (AWS, Oracle, GCP): its own private address, which coturn listens on.
# Leave empty where the public address is on the machine's own interface.
PRIVATE_IP=

# The secret the OpenIGI team gave you for this relay. Leave empty to keep the one install.sh saved last time.
SECRET=

# A domain name pointing at PUBLIC_IP, for TURN over TLS on 5349 (networks that only pass HTTPS-like traffic). Leave
# empty for a relay reached by its address alone: TURN over UDP and TCP on 3478 still works.
DOMAIN=

# How the certificate for DOMAIN is got: certbot (a standalone Let's Encrypt certificate; needs port 80 free), caddy
# (copied from a Caddy already serving DOMAIN on this machine), or none.
TLS=none

# Asked by Let's Encrypt with TLS=certbot, for expiry notices.
EMAIL=

# The UDP ports handed out to relayed players, one each. Keep the default unless they clash with something.
MIN_PORT=49160
MAX_PORT=49999

# The most the whole relay may send, in bytes a second: 6000000 is 48 Mbit/s. Set it below your VPS's link.
BPS_CAPACITY=6000000
