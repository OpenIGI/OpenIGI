<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- SPIRV-Cross is a C library reached through pointers. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- The tool writes the very types the catalogue reads back, so both sides share one set of
         records and a change to the generated schema cannot reach only one of them. -->
    <ProjectReference Include="..\..\src\Rendering\OpenIGI.Shaders\OpenIGI.Shaders.csproj" />
    <ProjectReference Include="..\OpenIGI.Tools.Common\OpenIGI.Tools.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Translates the SPIR-V to the GLSL the OpenGL backend compiles. See GlslTranslator. -->
    <PackageReference Include="Silk.NET.SPIRV.Cross" />
    <PackageReference Include="Silk.NET.SPIRV.Cross.Native" />
  </ItemGroup>

</Project>
