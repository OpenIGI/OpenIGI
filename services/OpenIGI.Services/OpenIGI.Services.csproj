<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- The update service behind api.openigi.com: it indexes the releases on the download store and tells
       the launcher what is newest on each channel. It references the release contract and nothing of
       the game, and runs framework-dependent in the stock ASP.NET image (deploy/vm/compose.yml). -->

  <PropertyGroup>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- One instance on one machine, for a handful of endpoints: the slim host keeps it small. -->
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="OpenIGI.Services.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core\OpenIGI.Releases\OpenIGI.Releases.csproj" />
  </ItemGroup>

</Project>
