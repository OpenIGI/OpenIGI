<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- StbTrueTypeSharp is a thin unsafe port of stb_truetype: its rasterisers take raw byte* and
         return byte*. The font-atlas builder is the only unsafe code in the project, fenced into
         OpenIGI.UI.Text. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- No graphics project at all. OpenIGI.UI draws through its own IUiRenderer seam and reads devices
         through OpenIGI.Input, so the same widgets run in the game (OpenIGI.UI.Rhi, over the sprite
         batch) and in the launcher (OpenIGI.UI.Skia, over a Skia canvas). See README.md. -->
    <ProjectReference Include="..\..\Core\OpenIGI.Core\OpenIGI.Core.csproj" />
    <ProjectReference Include="..\..\Platform\OpenIGI.Input\OpenIGI.Input.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure-managed TrueType rasteriser; version is pinned centrally in Directory.Packages.props. -->
    <PackageReference Include="StbTrueTypeSharp" />
  </ItemGroup>

</Project>
