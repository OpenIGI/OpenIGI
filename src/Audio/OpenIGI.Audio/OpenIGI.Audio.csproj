<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\Core\OpenIGI.Core\OpenIGI.Core.csproj" />
    <!-- Emits the module initialiser that registers AudioCVars. Without it the snd_* variables exist
         only once something first touches the class, which happens after settings.cfg and the
         +statements have been read, so a saved audio setting would not load and "snd_preset vanilla"
         would be an unknown variable. -->
    <ProjectReference Include="..\..\Core\OpenIGI.Generators\OpenIGI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
