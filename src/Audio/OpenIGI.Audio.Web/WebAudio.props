<Project>
  <!--
    The page's half of the browser's audio device, for a browser-wasm application to import: audio.js is
    served beside the page, which registers its imports under WebAudioPage.ModuleName before the game
    starts.
  -->
  <ItemGroup>
    <Content Include="$(MSBuildThisFileDirectory)audio.js"
             Link="wwwroot/audio.js"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
