<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- One game's content: its data layout, its format profile and the content modules that register
         its task types, script natives and tables. Never references the other title project; only an app
         composition root may name both, and it does so through IGameTitleRuntime. -->
    <ProjectReference Include="..\OpenIGI.Core\OpenIGI.Core.csproj" />
    <ProjectReference Include="..\OpenIGI.Engine\OpenIGI.Engine.csproj" />
    <ProjectReference Include="..\OpenIGI.Formats\OpenIGI.Formats.csproj" />
    <ProjectReference Include="..\OpenIGI.Scripting\OpenIGI.Scripting.csproj" />
    <ProjectReference Include="..\OpenIGI.Game\OpenIGI.Game.csproj" />

    <!-- Rendering and Presentation are abstractions, not backends: IGraphicsDevice and the presenter
         interfaces. Layering rule 1 allows them below apps/; what it forbids is naming a backend. This
         title's renderers live here because a renderer that knows I.G.I. 1's terrain format is game
         content that happens to draw. -->
    <ProjectReference Include="..\OpenIGI.Rendering\OpenIGI.Rendering.csproj" />
    <ProjectReference Include="..\OpenIGI.Presentation\OpenIGI.Presentation.csproj" />
  </ItemGroup>

</Project>
