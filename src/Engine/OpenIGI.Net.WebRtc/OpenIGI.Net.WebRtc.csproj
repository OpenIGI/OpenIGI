<Project Sdk="Microsoft.NET.Sdk">

  <!--
    WebRTC data channels for the desktop build and the dedicated server, over libdatachannel (MPL-2.0) through its C API.
    The native library is built by tools/native/build-datachannel.ps1 into third-party/ and copied beside the game by
    DataChannelNative.props; never part of the browser build, which has the page's own RTCPeerConnection.
  -->
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenIGI.Net\OpenIGI.Net.csproj" />
  </ItemGroup>

  <Import Project="DataChannelNative.props" />

</Project>
