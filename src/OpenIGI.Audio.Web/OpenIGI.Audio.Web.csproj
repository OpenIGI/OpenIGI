<Project Sdk="Microsoft.NET.Sdk">

  <!-- The browser's audio device: the Web Audio API, through the functions audio.js gives the runtime.
       The C# half reads the page through IWebAudioPage, so everything but the JavaScript interop runs
       (and is tested) off the browser too. -->
  <PropertyGroup>
    <!-- The JavaScript interop's generated marshalling is unsafe code. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\OpenIGI.Core\OpenIGI.Core.csproj" />
    <ProjectReference Include="..\OpenIGI.Audio\OpenIGI.Audio.csproj" />
  </ItemGroup>

</Project>
