<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- Project I.G.I.: its data layout, its format profile, the content modules that register its task
         types, script natives and tables, and its gameplay: its soldiers' minds, its player, its doors,
         lifts, pickups and menus. Never references the other title project; only an app composition root
         may name both, and it does so through IGameTitleRuntime. -->
    <ProjectReference Include="..\..\Core\OpenIGI.Core\OpenIGI.Core.csproj" />
    <ProjectReference Include="..\..\Engine\OpenIGI.Engine\OpenIGI.Engine.csproj" />
    <ProjectReference Include="..\..\Core\OpenIGI.Formats\OpenIGI.Formats.csproj" />
    <ProjectReference Include="..\..\Core\OpenIGI.Scripting\OpenIGI.Scripting.csproj" />
    <ProjectReference Include="..\OpenIGI.Game\OpenIGI.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emits the [ScriptParam] binders for this title's task classes. Build-time only: nothing of it ships. -->
    <ProjectReference Include="..\..\Core\OpenIGI.Generators\OpenIGI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
