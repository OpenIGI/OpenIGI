<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="OpenIGI.Game.Igi2.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- One game's content: its data layout, its format profile and the content modules that register
         its task types, script natives and tables. Never references the other title project; only an app
         composition root may name both, and it does so through IGameTitleRuntime. -->
    <ProjectReference Include="..\..\Core\OpenIGI.Core\OpenIGI.Core.csproj" />
    <ProjectReference Include="..\..\Engine\OpenIGI.Engine\OpenIGI.Engine.csproj" />
    <ProjectReference Include="..\..\Core\OpenIGI.Formats\OpenIGI.Formats.csproj" />
    <ProjectReference Include="..\..\Core\OpenIGI.Scripting\OpenIGI.Scripting.csproj" />
    <ProjectReference Include="..\OpenIGI.Game\OpenIGI.Game.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Rendering's value types (vertices, the camera), which the game's own geometry is made of. How the game is
         drawn is OpenIGI.Presentation.Igi2. -->
    <ProjectReference Include="..\..\Rendering\OpenIGI.Rendering\OpenIGI.Rendering.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Emits the [ScriptParam] binders for this title's task classes. Build-time only: nothing of it
         ships. A task class without it compiles and registers, and then reports zero parameters against
         a declaration that has fourteen. -->
    <ProjectReference Include="..\..\Core\OpenIGI.Generators\OpenIGI.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

</Project>
